# ── App ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-character-string
VITE_API_BASE_URL=http://localhost:8000

# ── Email Alerts ───────────────────────────────────────────────────────────
# Gmail account that sends WAF attack alerts.
ALERT_FROM_EMAIL=youralerts@gmail.com
# Gmail App Password (16 chars) — NOT your normal password.
# Create one at: https://myaccount.google.com/apppasswords
ALERT_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where alerts are delivered (defaults to ALERT_FROM_EMAIL if omitted).
ALERT_TO_EMAIL=youralerts@gmail.com
# Optional tuning:
# ALERT_MIN_SEVERITY=High        # Low | Medium | High | Critical
# ALERT_COOLDOWN_SEC=60          # min seconds between emails per attack type
