SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Service key bypasses RLS — keep it secret, set it in .env (never commit).
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── PostgreSQL ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── App ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-character-string
VITE_API_BASE_URL=http://localhost:8000

# ── Email Alerts (Resend HTTPS API — SMTP ports are blocked on Render free tier) ──
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender address. Without a verified domain on Resend, use their shared
# sandbox sender: onboarding@resend.dev (can only send to your own signup email).
ALERT_FROM_EMAIL=onboarding@resend.dev
# Where alerts are delivered.
ALERT_TO_EMAIL=youralerts@gmail.com
# Optional tuning:
# ALERT_MIN_SEVERITY=High        # Low | Medium | High | Critical
# ALERT_COOLDOWN_SEC=60          # min seconds between emails per attack type
